{
  "name": "node-minimal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Real-time Smelter example: stream a composed scene over RTMP and preview it with ffplay.",
  "scripts": {
    "start": "tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@swmansion/smelter": "0.4.0-rc.2",
    "@swmansion/smelter-node": "0.4.0-rc.3",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.17",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
